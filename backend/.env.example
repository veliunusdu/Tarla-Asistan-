ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://tarla:tarla-local@localhost:5432/tarla_asistani
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_HASH_SECRET=replace-with-another-random-secret
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60
OTP_EXPOSE_IN_RESPONSE=false
AGRONOMIST_PHONE_NUMBERS=
CORS_ORIGINS=http://localhost:3000
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8
WEATHER_STALE_AFTER_HOURS=3
MEDIA_STORAGE_PATH=data/media
MEDIA_MAX_UPLOAD_MB=15
MEDIA_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AI_CHAT_PROVIDER=local
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=20
PUSH_PROVIDER=noop
# Firebase Authentication: staging/development process started from backend/
# Keep the service-account JSON out of Git and use the mounted path in Docker.
FIREBASE_AUTH_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=demo2-c4265
PUSH_GATEWAY_URL=
PUSH_GATEWAY_TOKEN=
PUSH_TIMEOUT_SECONDS=8
LOG_LEVEL=INFO
METRICS_ENABLED=true
